{
  "schemaVersion": 1,
  "id": "foodies",
  "version": "${version}",

  "name": "Foodies",
  "description": "More crops, meat, ingredients and crafted food. Now with BEES!",
  "authors": [
    "Sayuzaur"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/foodies",
    "sources": "https://github.com/Sayuzaur/Foodies"
  },

  "license": "LGPL-3.0-or-later",
  "icon": "assets/foodies/icon.png",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "io.github.sayuzaur.foodies.events.init.ItemListener",
      "io.github.sayuzaur.foodies.events.init.BlockListener",
      "io.github.sayuzaur.foodies.events.init.FeatureListener"
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ],
    "bhcreative:event_bus": [
      "io.github.sayuzaur.foodies.events.init.CreativeListener"
    ],
    "gcapi3": [
      "io.github.sayuzaur.foodies.FoodiesMod"
    ]
  },
  "mixins": [
    "foodies.mixins.json"
  ],

  "suggests": {
    "bhcreative": "*",
    "alwaysmoreitems": "*"
  },
  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "farn_util": ">=3.3.2-babric",
    "stationapi": ">=2.0.0-alpha.6.2"
  },
  "breaks": {
    "honeybees": "*"
  }
}
